<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 这里改成你自己的 Mapper 接口路径 -->
<mapper namespace="com.expert.service.mapper.ExpertInfoMapper">

    <!-- 通用结果映射 -->
    <resultMap id="BaseResultMap" type="com.child.common.entity.po.ExpertInfo">
        <id column="expert_id" property="expertId"/>
        <result column="expert_name" property="expertName"/>
        <result column="expert_phone" property="expertPhone"/>
        <result column="expert_password" property="expertPassword"/>
        <result column="expert_email" property="expertEmail"/>
        <result column="work_place" property="workPlace"/>
        <result column="expert_type" property="expertType"/>
    </resultMap>

    <update id="updateExpertInfo" parameterType="com.child.common.entity.po.ExpertInfo">
        update expert_info
        <set>
            <if test="expertName != null">expert_name = #{expertName},</if>
            <if test="expertPhone != null">expert_phone = #{expertPhone},</if>
            <if test="expertPassword != null">expert_password = #{expertPassword},</if>
            <if test="expertEmail != null">expert_email = #{expertEmail},</if>
            <if test="workPlace != null">work_place = #{workPlace},</if>
            <if test="expertType != null">expert_type = #{expertType},</if>
        </set>
        where expert_id = #{expertId}
    </update>
</mapper>