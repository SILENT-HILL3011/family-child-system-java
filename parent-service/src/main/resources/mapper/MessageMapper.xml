<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parent.service.mapper.MessageMapper">

    <resultMap id="MessageBoardResultMap" type="com.child.common.entity.po.MessageBoard">
        <id column="message_id" property="messageId"/>
        <result column="family_id" property="familyId"/>
        <result column="publisher_id" property="publisherId"/>
        <result column="content" property="content"/>
        <result column="image_url" property="imageUrl"/>
        <result column="publish_time" property="publishTime"/>
        <result column="like_count" property="likeCount"/>
        <result column="comment_count" property="commentCount"/>
    </resultMap>

    <!-- 根据家庭ID + 时间段查询 -->
    <select id="selectMessage" resultMap="MessageBoardResultMap">
        SELECT *
        FROM message_board
        WHERE family_id = #{familyId}
          AND publish_time >= DATE_SUB(NOW(), INTERVAL #{timePeriod} DAY)
        ORDER BY publish_time DESC
    </select>

</mapper>